+// Returns a copy with the matching script's nukta placed on the last eligible D / Dh.
+static NSString *NuktaRewrite(NSString *s) {
+    NSInteger end = (NSInteger)s.length;
+    if (end < 1) return nil;
+    if (end >= 2 && [s characterAtIndex:end - 1] == ' ' && (IndicMark([s characterAtIndex:end - 2]) || IndicLetter([s characterAtIndex:end - 2]))) end--;
+    NSInteger i = end - 1;
+    while (i > 0 && IndicMark([s characterAtIndex:i])) i--;
+    if (i < 0 || !IndicLetter([s characterAtIndex:i])) return nil;
+    NSInteger cs = i;
+    while (cs > 0 && Nrm([s characterAtIndex:cs - 1]) == 0x0B4D) { cs--; if (cs > 0 && IndicLetter([s characterAtIndex:cs - 1])) cs--; else break; }
+    for (NSInteger j = end - 1; j >= cs; j--) {
+        unichar u = [s characterAtIndex:j];
+        if ((Nrm(u) == 0x0B21 || Nrm(u) == 0x0B22) && !(j + 1 < end && Nrm([s characterAtIndex:j + 1]) == 0x0B3C)) {
+            NSMutableString *out = [s mutableCopy];
+            NSString *nuk = NuktaForCharacter(u);
+            if (!nuk) return nil;
+            [out insertString:nuk atIndex:j + 1];
+            return out;
+        }
+    }
+    return nil;
